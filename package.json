{
  "name": "doubt-ai",
  "version": "0.2.0",
  "description": "Turn contested questions into interactive, source-grounded evidence maps.",
  "type": "module",
  "license": "MIT",
  "author": "Oleg Alshaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alsoleg89/doubt.git"
  },
  "homepage": "https://github.com/alsoleg89/doubt#readme",
  "bugs": {
    "url": "https://github.com/alsoleg89/doubt/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agent-skills",
    "argument-mapping",
    "decision-making",
    "evidence-map",
    "fact-checking",
    "knowledge-graph",
    "research",
    "source-grounding",
    "verification",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "gemini",
    "llm"
  ],
  "bin": {
    "doubt": "bin/doubt.js"
  },
  "files": [
    "benchmarks",
    "bin",
    "docs/demo.svg",
    "examples",
    "src",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "demo": "node bin/doubt.js demo --out examples/what-should-doubt-become.html",
    "benchmark": "node benchmarks/evidence-contract.mjs",
    "benchmark:check": "node benchmarks/evidence-contract.mjs --check-only",
    "lint": "node --check bin/doubt.js && node --check src/cli.js && node --check src/map.js && node --check src/render-map.js && node --check src/install.js",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run benchmark:check",
    "prepack": "npm run check"
  }
}
